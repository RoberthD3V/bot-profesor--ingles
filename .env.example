# Copia este archivo como .env y rellena los valores. ¡Nunca subas el .env!
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=

# Opcionales (estos son los valores por defecto)
# Hora de la tarea diaria en formato cron: "minuto hora * * *"
HORA_TAREA=0 9 * * *
ZONA_HORARIA=Europe/Madrid
GROQ_MODEL=openai/gpt-oss-120b
# Ruta del archivo de datos (en el servidor, apúntala a un volumen persistente)
# RUTA_ESTADO=/data/estado.json
